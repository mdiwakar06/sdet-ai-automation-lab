{
  "openapi": "3.1.0",
  "info": {
    "title": "E-Commerce Customer & Order API",
    "version": "1.1.0-observed",
    "description": "Observed runtime contract extracted by DriftGuard"
  },
  "paths": {
    "/api/v1/users/{userId}": {
      "get": {
        "summary": "Get user profile",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "User profile object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name", "spendingLimit", "loyaltyPoints"],
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "name": { "type": "string" },
                    "tier": { "type": "string", "enum": ["STANDARD", "GOLD", "VIP"] },
                    "spendingLimit": { "type": "string" },
                    "bio": { "type": ["string", "null"], "nullable": true },
                    "loyaltyPoints": { "type": "integer" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/checkout/orders": {
      "post": {
        "summary": "Submit new order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["items", "paymentMethod", "fraudSessionId"],
                "properties": {
                  "items": { "type": "array" },
                  "paymentMethod": { "type": "string" },
                  "fraudSessionId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["orderId", "status", "total"],
                  "properties": {
                    "orderId": { "type": "string" },
                    "status": { "type": "string", "enum": ["PENDING", "CONFIRMED", "PROCESSING"] },
                    "total": { "type": "number" },
                    "trackingUrl": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/promotions/active": {
      "get": {
        "summary": "List active promotions",
        "responses": {
          "200": {
            "description": "Promotions list"
          }
        }
      }
    }
  }
}
